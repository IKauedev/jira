# ========================================
# .env.example - Template de Variáveis de Ambiente
# ========================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (não versionado)
# 2. Preencha os valores conforme seu ambiente
# 3. NÃO compartilhe este arquivo em ambientes compartilhados
# 4. Adicione .env ao .gitignore
#
# ========================================

# ========================================
# AMBIENTE (local, dev, homolog, prod)
# ========================================
SPRING_PROFILES_ACTIVE=dev

# ========================================
# JWT - Development
# ========================================
# (Deixe como está para development)
JWT_SECRET_DEV=dev-secret-key-only-for-development-not-secure-at-all-change-in-production-immediately

# ========================================
# JWT - Homologation
# ========================================
# Gere uma nova chave com: openssl rand -base64 32
JWT_SECRET_HOMOLOG=homolog-secret-key-for-testing-environment-should-be-strong-and-unique-per-environment

# ========================================
# JWT - Production
# ========================================
# ⚠️ OBRIGATÓRIO EM PRODUÇÃO
# Gere uma nova chave forte com: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_SECRET_KEY_MINIMUM_32_CHARACTERS

# ========================================
# MongoDB - Development
# ========================================
MONGO_HOST_DEV=localhost
MONGO_PORT_DEV=27017
MONGO_DATABASE_DEV=jira_db

# ========================================
# MongoDB - Homologation
# ========================================
MONGO_HOST_HOMOLOG=mongodb-homolog
MONGO_PORT_HOMOLOG=27017
MONGO_DATABASE_HOMOLOG=jira_db_homolog
MONGO_USER_HOMOLOG=admin
MONGO_PASSWORD_HOMOLOG=password123

# ========================================
# MongoDB - Production
# ========================================
# ⚠️ OBRIGATÓRIO EM PRODUÇÃO
MONGODB_URI=mongodb://admin:CHANGE_ME_PASSWORD@mongodb-prod:27017/jira_db_prod?authSource=admin&replicaSet=rs0

# ========================================
# Server Configuration
# ========================================
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# ========================================
# Logging
# ========================================
# Níveis: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_JIRA=DEBUG
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_SECURITY=DEBUG

# ========================================
# Swagger/OpenAPI
# ========================================
SWAGGER_ENABLED=true
SWAGGER_PATH=/swagger-ui.html

# ========================================
# Application Info
# ========================================
APP_VERSION=1.0.0
APP_TITLE=Jira Backend Application
APP_ENVIRONMENT=development

# ========================================
# Database Configuration
# ========================================
# Para homolog/prod, use variáveis específicas
MONGO_AUTO_INDEX_CREATION=true

# ========================================
# DevTools (apenas em development)
# ========================================
DEVTOOLS_RESTART_ENABLED=true

# ========================================
# Actuator (Spring Boot Metrics)
# ========================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# ========================================
# CORS Configuration
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ========================================
# Security
# ========================================
# Token expiration em milissegundos
# DEV: 24 horas (86400000)
# HOMOLOG: 7 dias (604800000)
# PROD: 1 hora (3600000)
JWT_EXPIRATION=86400000

# ========================================
# Cache Configuration (opcional)
# ========================================
CACHE_ENABLED=true
CACHE_TIME_TO_LIVE=3600

# ========================================
# Amazon SES - Email Configuration (para notificações)
# ========================================
EMAIL_ENABLED=false
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=CHANGE_ME_SES_SMTP_USERNAME
SES_SMTP_PASSWORD=CHANGE_ME_SES_SMTP_PASSWORD
SES_FROM_EMAIL=noreply@seudominio.com
SES_SMTP_AUTH=true
SES_SMTP_STARTTLS_ENABLE=true
PASSWORD_RESET_BASE_URL=http://localhost:8080/reset-password
PASSWORD_RESET_EXPIRATION_HOURS=24
PASSWORD_RESET_INCLUDE_TOKEN_IN_RESPONSE=true

# ========================================
# External Integrations
# ========================================

# GitHub Integration
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_URL=https://api.github.com

# Slack Integration
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Integration Service Security
# local: pode ficar vazio; dev: pode usar dev-integration-api-key-change-me.
# homolog/prod: gere uma chave forte e armazene no Secrets Manager ou SSM.
INTEGRATION_API_KEY=CHANGE_ME_WITH_A_RANDOM_INTERNAL_KEY
INTEGRATION_API_KEY_HEADER=X-Integration-Api-Key

# MongoDB exclusivo do integration-service, usado nos perfis homolog/prod.
INTEGRATION_MONGODB_URI=mongodb://admin:CHANGE_ME_PASSWORD@mongodb-prod:27017/integration_db?authSource=admin&replicaSet=rs0

# ========================================
# Observability (Prometheus, OpenTelemetry)
# ========================================
METRICS_EXPORT_PROMETHEUS=true
TRACING_ENABLED=false
TRACING_JAEGER_URL=http://localhost:14268/api/traces

# ========================================
# Feature Flags
# ========================================
FEATURE_NOTIFICATION_ENABLED=true
FEATURE_INTEGRATION_ENABLED=true
FEATURE_ADVANCED_SEARCH_ENABLED=false

# ========================================
# TimeZone
# ========================================
TZ=America/Sao_Paulo
